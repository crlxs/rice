#!/bin/sh
export PATH="$HOME/.local/bin:$PATH"
if ! command -v dwm >/dev/null 2>&1; then
    echo "rice: dwm is missing from PATH; rerun the suckless installation." >&2
    exit 127
fi
. "$HOME/.config/x11/xprofile"
while :; do
    xsetroot -name " $(date '+%F %R') "
    sleep 60
done &
status_pid=$!
# XRender also works on guests without OpenGL/3D acceleration.
mkdir -p "$HOME/.cache"
picom --backend xrender >"$HOME/.cache/picom.log" 2>&1 &
compositor_pid=$!
trap 'kill "$status_pid" "$compositor_pid" 2>/dev/null || :' EXIT HUP INT TERM
dbus-run-session -- dwm
